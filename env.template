# Modèle de configuration : cp env.template .env, puis renseigner les valeurs.
# Le fichier .env n'est jamais versionné.

# --- Django ---
# Générer : python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=changer-moi
DEBUG=False
# Domaine ajouté à ALLOWED_HOSTS (ex : dpse.aidn.ci). localhost en dev.
DOMAIN=localhost

# --- Base de données (PostgreSQL, service "db" du docker-compose) ---
DB_NAME=dpse
DB_USER=dpse_user
DB_PASSWORD=changer-moi
DB_HOST=db
DB_PORT=5432

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- Email (compte Gmail d'envoi + mot de passe d'application) ---
EMAIL_HOST_USER=changer-moi@gmail.com
EMAIL_HOST_PASSWORD=changer-moi
# Expéditeur affiché (par défaut : EMAIL_HOST_USER)
DEFAULT_FROM_EMAIL=changer-moi@gmail.com
